{
  "name": "jrk-portfolio",
  "version": "3.1.1",
  "private": true,
  "type": "module",
  "description": "Jayesh Ranjan Kesari — portfolio. Turborepo + pnpm workspace.",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@jrk/web",
    "build": "turbo run build contributions --filter=@jrk/web",
    "preview": "pnpm --filter @jrk/web preview",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run typecheck test && tsc -p api && biome check .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck:api": "tsc -p api"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  }
}
