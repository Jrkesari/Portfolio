{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/routeTree.gen.ts", "!**/dist", "!**/dist-ssr", "!**/public", "!**/*.css"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      // Content is hand-laid data — one span, metric or line per row reads like a table.
      "includes": ["packages/content/src/**"],
      "formatter": { "enabled": false }
    },
    {
      // The Prompt Golf function from v2: untyped Vercel req/res, and env that turbo never sees.
      "includes": ["api/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        // The ASCII diagrams are role="img" divs by design; their text is decorative.
        "useSemanticElements": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "complexity": {
        // Every figure is String.raw, so a future one with a backslash can't break.
        "noUselessStringRaw": "off"
      },
      "suspicious": {
        // Box-drawing and Devanagari strings are intentional.
        "noIrregularWhitespace": "off"
      }
    }
  }
}
